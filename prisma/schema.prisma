datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                   String            @id @default(cuid())
  name                 String
  monthly_token_budget Int               @default(50000)
  tokens_used          Int               @default(0)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  feedback_entries     FeedbackEntry[]

  @@map("tenants")
}

model FeedbackEntry {
  id         String            @id @default(cuid())
  tenant_id  String
  raw_text   String
  source     String            @default("web") // "web", "email", "api"
  status     String            @default("pending") // "pending", "processed", "failed"
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  analysis   FeedbackAnalysis?

  @@index([tenant_id, created_at])
  @@map("feedback_entries")
}

model FeedbackAnalysis {
  id              String        @id @default(cuid())
  feedback_id     String        @unique
  category        String        // "bug", "feature_request", "billing", "other"
  urgency         String        // "low", "medium", "high", "critical"
  summary         String
  sentiment       String        // "positive", "neutral", "negative"
  tokens_consumed Int           @default(0)
  created_at      DateTime      @default(now())

  feedback_entry  FeedbackEntry @relation(fields: [feedback_id], references: [id], onDelete: Cascade)

  @@map("feedback_analysis")
}
